# Somente nomes. Defina os valores no perfil do shell ou no provedor de deploy.
# Com AGENTE_COM_MODELO=1 e a chave, o agente usa o modelo; os dados seguem sintéticos.
AGENTE_COM_MODELO=
# Com NARA_MCP_URL, a entrega à Nara simulada passa pelo servidor MCP dela.
NARA_MCP_URL=
# Com AGENTE_BUSCA_REAL=1, a busca soma as fontes externas abaixo, cada uma com a sua chave.
AGENTE_BUSCA_REAL=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=
MODELO_PADRAO=
MODELO_ALTERNATIVO=
MAX_TOKENS_MODELO=
# Análises simultâneas. Vazio: 1 na demonstração e 5 com o modelo ligado (limite medido da conta: 25).
CONCORRENCIA_MODELO=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LIMITE_GASTO_SESSAO_USD=
# Origens do painel liberadas no CORS, separadas por vírgula (padrão localhost:3000). No deploy, a URL da Vercel.
ORIGENS_PAINEL=
# Pedidos por minuto e por sessão na API (padrão 600).
LIMITE_REQUISICOES_POR_MINUTO=
FONTES_HABILITADAS=
GITHUB_CONTAS_CONSENTIDAS=
GITHUB_COLETA_REAL=
MODO_DADOS=
# LinkdAPI (linkdapi.com): com LINK_API_KEY, entra na busca real logo depois do LinkedIn pela Brave, antes do PDL e da Brave.
# Chaves de reserva: LINK_API_KEY_2, LINK_API_KEY_3... Sem crédito ou recusada, a cadeia passa para a seguinte.
# Custo: 1 crédito por requisição, até US$ 0,01 cada. Uma página faz 1 busca e até LINKDAPI_PERFIS_POR_PAGINA
# perfis completos: no padrão, até 11 créditos (US$ 0,11).
LINK_API_KEY=
LINK_API_KEY_2=
# Local da busca (padrão Brazil): um nome entra na palavra-chave; um número vai como geoUrn.
LINKDAPI_LOCAL=
# Perfis completos pedidos por página, de 0 a 50 (padrão 10).
LINKDAPI_PERFIS_POR_PAGINA=
# EnvoAPI (envoapi.com, serviço independente do LinkedIn): só com AGENTE_BUSCA_REAL=1. Consulta o e-mail
# que a própria pessoa publicou no LinkedIn, só para quem o agente indicou e não saiu, uma vez por pessoa e
# empresa. Custo: 1 crédito por consulta, mesmo sem e-mail. O plano grátis tem 100 créditos. Sem chave, nada é consultado.
ENVO_API_KEY=
# LinkedIn pela Brave: com BRAVE_API_KEY e ENVO_API_KEY ou LINK_API_KEY, entra primeiro na busca real. A Brave
# só acha os links dos perfis (site:linkedin.com/in); a EnvoAPI extrai o perfil completo e, se ela falhar, a LinkdAPI.
# Quem não for extraído não entra. Custo por página: 1 busca da Brave (US$ 0,005) e até LINKEDIN_PERFIS_POR_PAGINA
# perfis, a 1 crédito (até US$ 0,01) cada. Perfis por página, de 0 a 50 (padrão 10); o teto cai para caber no orçamento.
LINKEDIN_PERFIS_POR_PAGINA=
# Envio real do convite por e-mail, pelo Resend (resend.com). Só com AGENTE_ENVIO_REAL=1, RESEND_API_KEY e
# EMAIL_FROM juntos; sem os três, o convite fica no mensageiro simulado. Só sai o convite de quem veio da busca
# real e publicou o e-mail; pessoa sintética nunca recebe. EMAIL_FROM é o remetente verificado no Resend,
# como "CORA <convites@seu-dominio>".
# O envio real manda uma única mensagem por pessoa e vaga, sem lembrete: o SAIR respondido por e-mail é
# registrado à mão.
AGENTE_ENVIO_REAL=
RESEND_API_KEY=
EMAIL_FROM=
# Link do botão do e-mail real, só https (por exemplo, https://wa.me/55...). Vazio: o e-mail vai sem botão e
# pede que a pessoa responda. O link da Nara simulada nunca vai num e-mail real.
CONVITE_LINK=
BRAVE_API_KEY=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONA_WEB=
# A SERP da Bright Data usa alvo Google e fica desligada: exige a zona de busca e o interruptor igual a 1.
BRIGHTDATA_ZONA_BUSCA=
BRIGHTDATA_BUSCA_HABILITADA=
# Com PDL_API_KEY, a busca da People Data Labs entra primeiro, antes da Brave, e o enriquecimento entra por último.
# Cada registro devolvido custa até US$ 0,28. Uma página de 10 custa até US$ 2,80 e não cabe no orçamento
# de execução padrão (US$ 1), e a busca do PDL fica fora da cadeia: para usar, suba PROVEDORES_ORCAMENTO_EXECUCAO_USD
# (e o da empresa, padrão US$ 5).
PDL_API_KEY=
PDL_MIN_LIKELIHOOD=
# País do filtro da busca, em inglês e minúsculas, como no PDL (padrão brazil).
PDL_PAIS=
# Registros por página da busca, de 1 a 100 (padrão 10). O custo máximo de cada página é esse número vezes US$ 0,28.
PDL_TAMANHO_PAGINA=
PROVEDORES_ORCAMENTO_EMPRESA_USD=
PROVEDORES_ORCAMENTO_EXECUCAO_USD=
# WhatsApp real pela Evolution API local (infra/evolution). O ./dev.sh preenche tudo sozinho.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
EVOLUTION_WEBHOOK_TOKEN=
# Número pareado, para o link wa.me do convite. Vazio: a API pergunta à Evolution.
WHATSAPP_NUMERO=
# Só responde a estes números (com DDI, separados por vírgula). Vazio: responde a quem escrever.
WHATSAPP_NUMEROS_PERMITIDOS=
# Com VOZ_REAL=1, as respostas também saem em áudio pela Featherless (Kokoro, voz pf_dora).
VOZ_REAL=
VOZ_MODELO=
VOZ_NOME=
